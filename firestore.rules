rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /adminConfig/{document} { allow read: if true; allow write: if request.auth != null; }
    match /services/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /doctors/{doc}  { allow read: if true; allow write: if request.auth != null; }
    match /doctorCredentials/{doctorId} { allow read: if true; allow write: if request.auth != null; }
    match /testimonials/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /technologies/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /siteContent/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /internshipSlides/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /appointments/{doc} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /messages/{doc} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /activityLog/{doc} { allow create: if true; allow read, update: if request.auth != null; }
    match /internships/{doc=**} { allow read: if true; allow write: if request.auth != null; }
    match /internshipApplications/{doc} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /annualReports/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /newsletters/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /galleryImages/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /successStories/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /events/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /articles/{doc} { allow read: if true; allow write: if request.auth != null; }
    match /faqs/{doc} { allow read: if true; allow write: if request.auth != null; }
  }
}
