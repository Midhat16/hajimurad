rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read access for public collections
    match /hospitalProfile/{docId} { allow read: if true; allow write: if true; }
    match /services/{docId} { allow read: if true; allow write: if true; }
    match /doctors/{docId} { allow read: if true; allow write: if true; }
    match /technologies/{docId} { allow read: if true; allow write: if true; }
    match /whyChooseUs/{docId} { allow read: if true; allow write: if true; }
    match /aboutContent/{docId} { allow read: if true; allow write: if true; }

    // Internships Collections
    match /internships/{docId} { allow read: if true; allow create, update, delete: if true; }
    match /internshipApplications/{docId} { allow create: if true; allow read, update, delete: if true; }

    // Media Collections (NEW)
    match /annualReports/{docId} { allow read: if true; allow create, update, delete: if request.auth != null; }
    match /newsletters/{docId} { allow read: if true; allow create, update, delete: if request.auth != null; }
    match /galleryImages/{docId} { allow read: if true; allow create, update, delete: if request.auth != null; }
    match /successStories/{docId} { allow read: if true; allow create, update, delete: if request.auth != null; }

    // Appointments, Messages, Notifications, Activity Logs
    match /appointments/{docId} { allow read, create, update, delete: if true; }
    match /messages/{docId} { allow read, create, update, delete: if true; }
    match /doctor_messages/{docId} { allow read, create, update, delete: if true; }
    match /notifications/{docId} { allow read, create, update, delete: if true; }
    match /activityLog/{docId} { allow read, create, update, delete: if true; }
    match /doctorCredentials/{docId} { allow read, create, update, delete: if true; }
    match /adminConfig/{docId} { allow read, create, update, delete: if true; }
  }
}
